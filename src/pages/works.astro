---
import Layout from "@/layouts/Layout.astro";
import { publications, projects, achievements } from "@/data/cv";
import { highlightAuthor } from "@/lib/utils";
import { ExpandableCards } from "@/components/ui/ExpandableCard";
---

<Layout title="Works & Publications">
  <div class="max-w-none">
    <h1 class="text-4xl font-bold mb-3">Works & Publications</h1>
    <p class="text-base-content/70 mb-12">研究論文、開発プロジェクト、受賞歴</p>

    <!-- Publications Section -->
    <section class="mb-16">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-1 h-8 rounded-full bg-brand-blue"></div>
        <h2 class="text-3xl font-bold text-base-content">Publications</h2>
      </div>
      <div class="grid gap-6">
        {publications.map((paper) => (
          <div class="card bg-base-100 shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 border-2 border-base-300 hover:border-brand-blue/60">
            <div class="card-body">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3 mb-3">
                <h3 class="text-xl font-bold flex-1">
                  {paper.link ? (
                    <a href={paper.link} class="hover:opacity-80 transition-opacity text-brand-blue" target="_blank" rel="noopener noreferrer">
                      {paper.title}
                    </a>
                  ) : (
                    <span>{paper.title}</span>
                  )}
                </h3>
                {paper.tags && paper.tags.length > 0 && (
                  <div class="flex gap-2 flex-wrap">
                    {paper.tags.map(tag => (
                      <span class="px-3 py-1 text-xs font-semibold rounded-full bg-brand-orange text-white">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div class="space-y-2 mb-4">
                <p class="text-sm">
                  <span class="font-semibold text-base-content/90">Authors:</span>{" "}
                  <span set:html={highlightAuthor(paper.authors)} />
                </p>
                <p class="text-sm text-base-content/70">
                  <span class="italic">{paper.journal}</span> • {paper.time}
                </p>
              </div>

              <p class="text-base text-base-content/80 leading-relaxed mb-4">{paper.abstract}</p>

              {paper.link && (
                <div class="card-actions justify-end">
                  <a href={paper.link} class="btn btn-sm gap-2 text-white border-0 hover:opacity-90 transition-opacity bg-brand-blue" target="_blank" rel="noopener noreferrer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    View Publication
                  </a>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Projects Section -->
    <section class="mb-16">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-1 h-8 rounded-full bg-brand-green"></div>
        <h2 class="text-3xl font-bold text-base-content">Projects</h2>
      </div>
      <ExpandableCards projects={projects} client:load />
    </section>

    <!-- Achievements Section -->
    {achievements && achievements.length > 0 && (
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-1 h-8 rounded-full bg-brand-red"></div>
          <h2 class="text-3xl font-bold text-base-content">Achievements</h2>
        </div>
        <div class="grid gap-6">
          {achievements.map((achievement) => (
            <div class="card bg-base-100 shadow-lg hover:shadow-2xl hover:-translate-y-1 hover:border-brand-red/60 transition-all duration-300 border-2 border-base-300">
              <div class="card-body">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3 mb-2">
                  <h3 class="text-xl font-bold flex-1">{achievement.title}</h3>
                  {achievement.tags && achievement.tags.length > 0 && (
                    <div class="flex gap-2 flex-wrap">
                      {achievement.tags.map(tag => (
                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-brand-red text-white">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                <p class="text-sm text-base-content/70 mb-3">{achievement.time}</p>
                <p class="text-base text-base-content/80 leading-relaxed">{achievement.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
