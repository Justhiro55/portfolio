---
import Layout from '../layouts/Layout.astro'

import { profile } from '@/settings'
import { projects, achievements } from '@/data/cv'
import ProfilePictures from '@/assets/profile_pictures.jpg'
import Hero from '@/components/ui/Hero.astro'

const { fullName, title, institute } = profile

// 最新のプロジェクト3つを取得
const recentProjects = projects.slice(0, 3)
---

<Layout>
	<!-- Hero Section -->
	<section class='flex items-center gap-12 border-b pb-12'>
		<Hero
			fullName={fullName}
			title={title}
			institute={institute}
			profilePicture={ProfilePictures}
		/>
	</section>

	<!-- Recent Projects Section -->
	<section class='py-12 border-b'>
		<div class="flex items-center gap-3 mb-6">
			<div class="w-1 h-8 rounded-full" style="background-color: #365C3B;"></div>
			<h2 class="text-2xl font-bold text-base-content">Recent Projects</h2>
		</div>
		<div class="grid md:grid-cols-3 gap-6">
			{recentProjects.map((project) => (
				<div class="card bg-base-100 shadow-md hover:shadow-xl transition-all duration-300 border-2 border-base-300 hover:border-[#365C3B]/60 hover:-translate-y-1">
					<div class="card-body p-4">
						<h3 class="text-base font-bold mb-2 leading-tight">{project.title.split('—')[0].trim()}</h3>
						<p class="text-xs text-base-content/60 mb-3">{project.time}</p>
						<p class="text-sm text-base-content/80 leading-relaxed line-clamp-3 mb-3">{project.description}</p>
						{project.links && (project.links.github || project.links.website || project.links.demo) && (
							<a href={project.links.github || project.links.website || project.links.demo} class="text-sm font-medium hover:opacity-80 transition-opacity" style="color: #365C3B;" target="_blank" rel="noopener noreferrer">
								View Project →
							</a>
						)}
					</div>
				</div>
			))}
		</div>
		<div class="mt-6 text-center">
			<a href="/works/" class="btn btn-sm gap-2 text-white border-0 hover:opacity-90 transition-opacity" style="background-color: #365C3B;">
				View All Projects
			</a>
		</div>
	</section>

	<!-- Achievements -->
	<section class='py-12'>
		<h2 class='text-3xl font-bold mb-8'>Achievements</h2>
		<div class='space-y-6'>
			{
				achievements.map(item => (
					<div class='p-6 rounded-lg text-base-content bg-base-200'>
						<div class='flex flex-col lg:flex-row lg:items-start lg:justify-between gap-2 mb-2'>
							<h3 class='text-xl font-semibold flex-1'>{item.title}</h3>
							{item.tags && item.tags.length > 0 && (
								<div class='flex gap-2 flex-wrap'>
									{item.tags.map(tag => (
										<span class='px-3 py-1 text-xs font-semibold rounded-full' style="background-color: #E8854A; color: #FFFFFF;">
											{tag}
										</span>
									))}
								</div>
							)}
						</div>
						<p class='text-base-content/70'>{item.time}</p>
					</div>
				))
			}
		</div>
	</section>
</Layout>

<style>
	.line-clamp-3 {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
