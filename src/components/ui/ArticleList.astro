---
interface Props {
  listTitle: string;
  listItems: {
    title: string;
    journal: string;
    time: string;
    tags?: string[];
  }[];
}
const {listTitle, listItems} = Astro.props
---

<h2 class='text-3xl font-bold mb-8'>Publications</h2>
		<div class='space-y-6'>
			{
				listItems.map(item => (
					<div class='p-6 rounded-lg text-base-content bg-base-200'>
						<h3 class='text-xl font-semibold mb-2'>{item.title}</h3>
						{item.tags && item.tags.length > 0 && (
							<div class='mb-2'>
								{item.tags.map(tag => (
									<span class='inline-block bg-blue-50 text-blue-700 border border-blue-200 text-sm px-2 py-0.5 rounded mr-2'>
										{tag}
									</span>
								))}
							</div>
						)}
						<p>
							{item.journal} • {item.time}
						</p>
					</div>
				))
			}
		</div>
