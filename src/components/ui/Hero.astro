---
import { Image } from 'astro:assets'
import SocialIcons from './SocialIcons.astro'
import { HeroTitle } from './HeroAnimated'

const {fullName, title, institute, profilePicture} = Astro.props
---

<div class='flex-1'>
  <p class="text-sm font-medium text-brand-blue mb-3 tracking-wide uppercase">Software Engineer</p>
  <HeroTitle fullName={fullName} client:load />
  <p class='text-xl text-base-content/70 mb-4'>{title}{institute ? ` ${institute}` : ''}</p>
  <p class='text-lg mb-6 text-base-content/80 leading-relaxed'>
    Took a leave of absence from graduate school—where I had been conducting research in network security—to join 42Tokyo, and later resumed my studies.
    <br>Currently pursuing the 42Tokyo curriculum in parallel, having completed the First Circle and advanced to the Second Circle, with graduation expected in 2026.
  </p>
  <div class='flex gap-4'>
    <SocialIcons />
  </div>
</div>
<div class='size-72 lg:block hidden'>
  <Image
    src={profilePicture}
    alt={fullName}
    class='w-full h-full object-cover rounded-full ring-4 ring-base-200 shadow-xl'
  />
</div>
