---
import { Image } from 'astro:assets'

import SocialIcons from './SocialIcons.astro'


const {fullName, title, institute, profilePicture} = Astro.props
---
<div class='flex-1'>
  <h1 class='text-4xl font-bold mb-4'>
    Welcome! I'm <span class='bg-gradient-to-r from-emerald-600 to-teal-600 bg-clip-text text-transparent'>{fullName}</span>
  </h1>
  <p class='text-xl text-gray-600 mb-4'>{title}{institute ? ` ${institute}` : ''}</p>
  <p class='text-lg mb-6'>
    Took a leave of absence from graduate school—where I had been conducting research in network security—to join 42Tokyo, and later resumed my studies.
    <br>Currently pursuing the 42Tokyo curriculum in parallel, having completed the First Circle and advanced to the Second Circle, with graduation expected in 2026.
    <br>I aim to continue taking on exciting challenges and expanding my potential.
  </p>
  <div class='flex gap-4'>
    <SocialIcons />
  </div>
</div>
<div class='size-72 lg:block hidden'>
  <!-- Add your profile image -->
  <Image
    src={profilePicture}
    alt={fullName}
    class='w-full h-full mask mask-circle size-44'
  />
</div>
