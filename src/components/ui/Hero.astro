---
import { Image } from 'astro:assets'
import SocialIcons from './SocialIcons.astro'
import { HeroTitle } from './HeroAnimated'

const {fullName, title, institute, profilePicture} = Astro.props
---

<div class='flex-1'>
  <p class="text-sm font-medium text-brand-blue mb-3 tracking-wide uppercase">Software Engineer</p>
  <HeroTitle fullName={fullName} client:load />
  <p class='text-xl text-base-content/70 mb-4'>{title}{institute ? ` ${institute}` : ''}</p>
  <p class='text-lg mb-6 text-base-content/80 leading-relaxed'>
    I joined Rakuten Group as an application engineer in April 2026. Before that, I earned my master's degree at Future University Hakodate, researching network security—specifically low-rate DoS attacks on TCP and MPTCP.
    <br>I also study at 42Tokyo, where I completed the First Circle and am now in the Second Circle, and I enjoy building apps at hackathons.
  </p>
  <div class='flex gap-4'>
    <SocialIcons />
  </div>
</div>
<div class='size-72 lg:block hidden'>
  <Image
    src={profilePicture}
    alt={fullName}
    class='w-full h-full object-cover rounded-full ring-4 ring-base-200 shadow-xl'
  />
</div>
