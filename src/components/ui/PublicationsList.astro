---
import { isSkill } from '@/types/cv';
import type { Skill, Publication } from '@/types/cv';
import { highlightAuthor } from '@/lib/utils'

interface Props {
	elements: (Skill | Publication)[]
}

const { elements } = Astro.props
---
<div class="grid gap-6">
  {elements.map((element) => (
    isSkill(element) ? (
      <div class="card bg-base-100 border-2 border-base-300 hover:border-brand-blue/60 hover:shadow-lg transition-all duration-300">
        <div class="card-body py-4">
          <h3 class="text-lg font-bold mb-2">{element.title}</h3>
          <p class="text-base-content/80">{element.description}</p>
        </div>
      </div>
    ) : (
      <div class="card bg-base-100 border-2 border-base-300 hover:border-brand-blue/60 hover:shadow-lg transition-all duration-300">
        <div class="card-body py-4">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3 mb-2">
            <h3 class="text-xl font-bold flex-1">
              {element.link ? (
                <a href={element.link} class="hover:opacity-80 transition-opacity text-brand-blue" target="_blank" rel="noopener noreferrer">
                  {element.title}
                </a>
              ) : (
                <span>{element.title}</span>
              )}
            </h3>
            {element.tags && element.tags.length > 0 && (
              <div class="flex gap-2 flex-wrap">
                {element.tags.map(tag => (
                  <span class="px-3 py-1 text-xs font-semibold rounded-full bg-brand-orange text-white">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>

          <div class="space-y-1 mb-3">
            <p class="text-sm">
              <span class="font-semibold text-base-content/90">Authors:</span>{" "}
              <span set:html={highlightAuthor(element.authors as string)} />
            </p>
            <p class="text-sm text-base-content/70">
              <span class="italic">{element.journal}</span> • {element.time}
            </p>
          </div>

          <p class="text-base text-base-content/80 leading-relaxed mb-3">{element.abstract}</p>

          {element.link && (
            <div class="card-actions justify-end">
              <a href={element.link} class="btn btn-sm gap-2 text-white border-0 hover:opacity-90 transition-opacity bg-brand-blue" target="_blank" rel="noopener noreferrer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                View Publication
              </a>
            </div>
          )}
        </div>
      </div>
    )
  ))}
</div>
